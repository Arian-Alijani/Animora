<Project Sdk="Microsoft.NET.Sdk">

  <!-- No sibling Modules.* reference and no reference to the App composition root are permitted
       here; cross-module work goes through Mediator (DIR-01, DIR-05, DT-01, AT-09). -->
  <ItemGroup>
    <ProjectReference Include="../Animora.Desktop.UI/Animora.Desktop.UI.csproj" />
    <ProjectReference Include="../Animora.Desktop.Data/Animora.Desktop.Data.csproj" />
    <ProjectReference Include="../Animora.Desktop.Infrastructure/Animora.Desktop.Infrastructure.csproj" />
    <ProjectReference Include="../../../shared/dotnet/Animora.SharedKernel/Animora.SharedKernel.csproj" />
    <ProjectReference Include="../../../shared/dotnet/Animora.Contracts/Animora.Contracts.csproj" />
  </ItemGroup>

  <!-- Request/handler types for this module's screens (DT-02). The source generator stays in the
       composition root, which discovers these handlers through its project reference. -->
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>

  <!-- Required by every project that owns .axaml views, even though the runtime assemblies already
       arrive through Animora.Desktop.UI: the XAML compiler ships as build assets and the
       InitializeComponent/x:Name generator as analyzer assets, and NuGet does not flow analyzer
       assets across a ProjectReference. Version stays pinned in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

</Project>
