<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Animora.Desktop.App.App">
  <Application.Styles>
    <!-- The one place the design system is applied: theme, tokens and the RTL root style come from
         Animora.Desktop.UI only, never per screen (DT-06, DESK-ARCH-06/12). -->
    <StyleInclude Source="avares://Animora.Desktop.UI/Theme/AnimoraTheme.axaml" />
  </Application.Styles>
</Application>
