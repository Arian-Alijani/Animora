<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Semantic color keys for ThemeVariant.Dark (DESK-ARCH-12) — same key set as Colors.Light.axaml so
    every consumer (Brushes.axaml, styles, controls) is theme-variant agnostic.

    The product-owner reference is light-theme only; a dark palette was never supplied (only the
    always-dark sidebar surfaces in design-reference.md §1.3, plus a partial derived table in §3).
    Per the phase owner's direction, this dark theme was designed rather than deferred:

    - Page/surface/border/divider/text steps are §3's derived table verbatim, plus one addition
      (`ColorSurfaceTrack`, not in §3) interpolated between `SurfaceMuted` and `Border`.
    - Primary shifts one brand step lighter (Brand400 instead of Brand500, §3's own note) so it keeps
      contrast against the darker page; its pressed/focus steps shift down the same ramp accordingly.
    - The rail keeps its role as the darkest anchor surface: its background is one notch darker than
      the dark page/surface (matching the strong light-mode contrast between the near-black rail and
      the mint page), instead of reusing the now-equally-dark page color.
    - Accent tints switch from flat pastel fills to the accent base color at ~18% alpha over the dark
      surface (matching §3's "accent base at 18% alpha" instruction); accent "strong" text steps are
      lightened versions of each base so they stay legible on a dark tint instead of reusing the
      light theme's near-black strong steps.

    See design-reference.md §3 addendum for the full rationale, and Palette.axaml's header for the
    ramp-step provenance of every value below.
  -->

  <!-- surface / page -->
  <Color x:Key="ColorPageBackground">#0B2526</Color>        <!-- NeutralPageDark -->
  <Color x:Key="ColorSurface">#0F3130</Color>               <!-- NeutralSurfaceDark -->
  <Color x:Key="ColorSurfaceMuted">#113D3C</Color>          <!-- NeutralSurfaceMutedDark -->
  <Color x:Key="ColorSurfaceTrack">#174443</Color>          <!-- NeutralSurfaceTrackDark (derived) -->

  <!-- border / divider -->
  <Color x:Key="ColorBorder">#1C4B49</Color>                <!-- NeutralBorderDark -->
  <Color x:Key="ColorDivider">#173F3E</Color>               <!-- NeutralDividerDark -->

  <!-- text -->
  <Color x:Key="ColorTextPrimary">#E7F2F0</Color>           <!-- NeutralTextPrimaryDark -->
  <Color x:Key="ColorTextSecondary">#A6BCB8</Color>         <!-- NeutralTextSecondaryDark -->
  <Color x:Key="ColorTextMuted">#6E8C8B</Color>             <!-- NeutralTextMutedDark -->
  <Color x:Key="ColorTextOnBrand">#FFFFFF</Color>           <!-- NeutralTextOnBrand (unchanged) -->

  <!-- rail (kept one notch darker than the dark page so it still anchors, see header) -->
  <Color x:Key="ColorRailBackground">#081C1D</Color>        <!-- RailBackgroundDark -->
  <Color x:Key="ColorRailItemActive">#113D3C</Color>        <!-- RailItemActive -->
  <Color x:Key="ColorRailItemHover">#0F2F2D</Color>         <!-- RailItemHoverDark -->
  <Color x:Key="ColorRailTextActive">#FFFFFF</Color>        <!-- RailTextActive -->
  <Color x:Key="ColorRailTextInactive">#A6BCB8</Color>      <!-- RailTextInactive -->
  <Color x:Key="ColorRailSectionLabel">#6E8C8B</Color>      <!-- RailSectionLabel -->

  <!-- primary (one brand step lighter than light theme, §3) -->
  <Color x:Key="ColorPrimary">#19A09B</Color>               <!-- Brand400 -->
  <Color x:Key="ColorPrimaryPressed">#109089</Color>        <!-- Brand500 -->
  <Color x:Key="ColorPrimaryFocusRing">#66C0B4</Color>      <!-- Brand300 -->

  <!-- accent tint / base / strong triads (tint = base @ 18% alpha over Surface, §3) -->
  <Color x:Key="ColorAccentInfoTint">#2E4E84DE</Color>      <!-- InfoTintDark -->
  <Color x:Key="ColorAccentInfoBase">#4E84DE</Color>        <!-- InfoBase -->
  <Color x:Key="ColorAccentInfoStrong">#9CC4F5</Color>      <!-- InfoStrongDark -->

  <Color x:Key="ColorAccentWarningTint">#2EEBA53C</Color>   <!-- WarningTintDark -->
  <Color x:Key="ColorAccentWarningBase">#EBA53C</Color>     <!-- WarningBase -->
  <Color x:Key="ColorAccentWarningStrong">#F5C878</Color>   <!-- WarningStrongDark -->

  <Color x:Key="ColorAccentVioletTint">#2E8C64D7</Color>    <!-- VioletTintDark -->
  <Color x:Key="ColorAccentVioletBase">#8C64D7</Color>      <!-- VioletBase -->
  <Color x:Key="ColorAccentVioletStrong">#C7ADF0</Color>    <!-- VioletStrongDark -->

  <Color x:Key="ColorAccentDangerTint">#2EE4574C</Color>    <!-- DangerTintDark -->
  <Color x:Key="ColorAccentDangerBase">#E4574C</Color>      <!-- DangerBase -->
  <Color x:Key="ColorAccentDangerStrong">#F2A79E</Color>    <!-- DangerStrongDark -->

  <Color x:Key="ColorAccentSuccessTint">#2E19A09B</Color>   <!-- Brand400 @ 18% alpha -->
  <Color x:Key="ColorAccentSuccessBase">#19A09B</Color>     <!-- Brand400 -->
  <Color x:Key="ColorAccentSuccessStrong">#66C0B4</Color>   <!-- Brand300 -->

  <!-- state overlays -->
  <Color x:Key="ColorStateHoverOverlay">#0AE7F2F0</Color>   <!-- StateHoverOverlayDark -->
  <Color x:Key="ColorStatePressedOverlay">#14E7F2F0</Color> <!-- StatePressedOverlayDark -->
  <Color x:Key="ColorStateFocusRing">#66C0B4</Color>        <!-- Brand300 -->
  <Color x:Key="ColorStateSelectedTint">#2E19A09B</Color>   <!-- Brand400 @ 18% alpha -->

</ResourceDictionary>
