<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Geometry tokens (design-reference.md §4, DESK-ARCH-12): spacing scale, corner radii, control
    heights/paddings, icon/avatar/accent-bar sizes, and the rail/top-bar dimensions. Most values are
    plain scalars (x:Double); radii are typed as CornerRadius and the two button paddings as
    Thickness (horizontal-only, vertical centering comes from Height + VerticalContentAlignment) so
    a consumer binds e.g. `CornerRadius="{StaticResource RadiusCard}"` / `Padding="{StaticResource
    ButtonPaddingX}"` directly with no converter. No literal length, radius, or size belongs outside
    this file (DT-06).
  -->

  <!-- 4.4 Spacing scale — the only gap values allowed anywhere in this project. -->
  <x:Double x:Key="Spacing2">2</x:Double>
  <x:Double x:Key="Spacing4">4</x:Double>
  <x:Double x:Key="Spacing8">8</x:Double>
  <x:Double x:Key="Spacing12">12</x:Double>
  <x:Double x:Key="Spacing16">16</x:Double>
  <x:Double x:Key="Spacing20">20</x:Double>
  <x:Double x:Key="Spacing24">24</x:Double>
  <x:Double x:Key="Spacing32">32</x:Double>
  <x:Double x:Key="Spacing40">40</x:Double>
  <x:Double x:Key="Spacing48">48</x:Double>

  <!-- 4.1 Layout -->
  <x:Double x:Key="RailWidth">240</x:Double>
  <x:Double x:Key="TopBarHeight">88</x:Double>
  <x:Double x:Key="ContentPaddingX">32</x:Double>
  <x:Double x:Key="ContentPaddingY">24</x:Double>
  <!-- The two scalars above as one Thickness (`32,24`) for whoever binds the page content inset
       straight to Padding — Padding needs a Thickness, and Avalonia's compiled XAML casts a
       StaticResource to the target property's type with no numeric conversion, so handing it the
       x:Double `ContentPaddingX` throws InvalidCastException at window construction. Same reason as
       CardPadding/ButtonPaddingX below; the scalars stay for Grid/offset math. -->
  <Thickness x:Key="ContentPadding">32,24</Thickness>
  <x:Double x:Key="CardGap">16</x:Double>
  <x:Double x:Key="HeroHeight">216</x:Double>
  <x:Double x:Key="SectionGap">24</x:Double>
  <!-- Rail inner inset (Spacing12 as a Thickness, for the same bind-straight-to-Padding reason). -->
  <Thickness x:Key="RailPadding">12</Thickness>

  <!-- 4.2 Radii -->
  <CornerRadius x:Key="RadiusHero">20</CornerRadius>
  <CornerRadius x:Key="RadiusCard">16</CornerRadius>
  <CornerRadius x:Key="RadiusBlock">12</CornerRadius>
  <CornerRadius x:Key="RadiusControl">10</CornerRadius>
  <CornerRadius x:Key="RadiusBadge">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- 4.3 Sizes -->
  <x:Double x:Key="ControlHeight">36</x:Double>
  <x:Double x:Key="ControlHeightSmall">28</x:Double>
  <x:Double x:Key="ControlHeightLarge">44</x:Double>
  <Thickness x:Key="ButtonPaddingX">16,0</Thickness>
  <Thickness x:Key="ButtonPaddingXLarge">20,0</Thickness>
  <x:Double x:Key="NavItemHeight">40</x:Double>
  <x:Double x:Key="IconSizeSmall">16</x:Double>
  <x:Double x:Key="IconSize">20</x:Double>
  <x:Double x:Key="IconSizeLarge">24</x:Double>
  <x:Double x:Key="IconTileSize">40</x:Double>
  <x:Double x:Key="AvatarSize">32</x:Double>
  <x:Double x:Key="AvatarSizeLarge">40</x:Double>
  <x:Double x:Key="AccentBarWidth">3</x:Double>
  <x:Double x:Key="AccentBarWidthLarge">4</x:Double>
  <!-- Thickness-typed, not x:Double, for the same reason as ButtonPaddingX above: StatCard.axaml
       and SectionCard.axaml bind these straight to Border.Padding, which needs a Thickness, not a
       double, to avoid an invalid-cast at compiled-XAML setter time. -->
  <Thickness x:Key="CardPadding">20</Thickness>
  <Thickness x:Key="CardPaddingLarge">24</Thickness>
  <Thickness x:Key="StrokeThickness">1</Thickness>
  <!-- `StrokeThickness` as a bottom-only edge, for the surfaces that separate themselves from what
       sits under them with a single hairline instead of a full outline (top bar -> content rule,
       design-reference §6). Flow-direction safe: no leading/trailing component to mirror. -->
  <Thickness x:Key="StrokeThicknessBottom">0,0,0,1</Thickness>

  <!-- Chip / count-badge padding (design-reference §6) — Thickness-typed for the same reason as
       ButtonPaddingX above: a Setter binds it straight to Padding with no converter. -->
  <Thickness x:Key="ChipPaddingX">12,0</Thickness>
  <Thickness x:Key="CountBadgePaddingX">6,0</Thickness>
  <x:Double x:Key="CountBadgeHeight">20</x:Double>

  <!-- InsightCallout padding (design-reference §6) — uniform, unlike the horizontal-only pairs
       above which are sized for their own single-line button/chip content. -->
  <Thickness x:Key="CalloutPadding">12</Thickness>

  <!-- DataGrid row/header geometry (DT-08, TECH_STACK §4) — not in §4.3's table, sized on the same
       4-DIP grid as the rest of this file. -->
  <x:Double x:Key="DataGridRowHeight">48</x:Double>
  <x:Double x:Key="DataGridHeaderHeight">44</x:Double>
  <Thickness x:Key="DataGridCellPadding">16,12</Thickness>

</ResourceDictionary>
