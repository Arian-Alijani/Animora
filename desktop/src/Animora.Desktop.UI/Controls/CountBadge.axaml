<UserControl x:Class="Animora.Desktop.UI.Controls.CountBadge"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Count badge (design-reference.md §6): Theme/Styles/Chips.axaml's `Border.CountBadge` defaults to
    the rail's Brand800 fill (nav-item badge); an optional Variant switches it to an accent Base
    fill for non-nav uses (e.g. a low-stock count) without a second style file.
  -->
  <Border x:Name="BadgeBorder" Classes="CountBadge">
    <TextBlock Text="{Binding Text, ElementName=Root}" />
  </Border>
</UserControl>
