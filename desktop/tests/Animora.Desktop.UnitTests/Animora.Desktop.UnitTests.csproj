<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test assemblies are not a cross-boundary surface, so XML docs are not produced (CM-05). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Handler/validator/formatter tests arrive with the code they cover; the project references
       the assemblies under test only when those assemblies have testable types (AG-01). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <!-- Localization/JalaliDateFormatter, Localization/PersianNumberFormatter,
       Localization/MoneyFormatter and their Converters/ wrappers (phase 01, items 25-28) are this
       project's first testable types.

       Phase 02 adds two more assemblies under test, referenced explicitly rather than left to flow
       transitively so this list stays the readable index of what this project covers:
       Animora.Desktop.App for Navigation/RouteRegistry + Navigation/NavigationService (item 24), and
       Animora.Desktop.Modules.Reporting for Handlers/GetHomeSummaryHandler (item 25). Referencing the
       composition root also brings Microsoft.Extensions.DependencyInjection along, which the
       navigation tests need to prove a route's view model comes out of the real container.

       Phase 03 adds the two shared leaf assemblies for SharedKernel/ (TenantId, Money, Result,
       UtcClock, the Clients validators). They already arrive transitively through the desktop
       projects above, but are listed explicitly so this element stays the readable index of what
       this project covers — and so a later trim of a desktop reference cannot silently drop the
       shared primitives out from under these tests. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Animora.Desktop.UI/Animora.Desktop.UI.csproj" />
    <ProjectReference Include="../../src/Animora.Desktop.App/Animora.Desktop.App.csproj" />
    <ProjectReference Include="../../src/Animora.Desktop.Modules.Reporting/Animora.Desktop.Modules.Reporting.csproj" />
    <ProjectReference Include="../../../shared/dotnet/Animora.SharedKernel/Animora.SharedKernel.csproj" />
    <ProjectReference Include="../../../shared/dotnet/Animora.Contracts/Animora.Contracts.csproj" />
  </ItemGroup>

</Project>
